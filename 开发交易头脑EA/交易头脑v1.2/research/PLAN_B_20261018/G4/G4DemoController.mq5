#property strict
input string InpRunId="";
input string InpTemplateA="";
input string InpTemplateB="";
string Snapshot(){string s="positions="+IntegerToString(PositionsTotal())+";orders="+IntegerToString(OrdersTotal());for(int i=0;i<PositionsTotal();i++){ulong t=PositionGetTicket(i);s+=";P:"+IntegerToString(t)+":"+PositionGetString(POSITION_SYMBOL)+":"+IntegerToString(PositionGetInteger(POSITION_MAGIC))+":"+DoubleToString(PositionGetDouble(POSITION_VOLUME),8);}for(int i=0;i<OrdersTotal();i++){ulong t=OrderGetTicket(i);s+=";O:"+IntegerToString(t)+":"+OrderGetString(ORDER_SYMBOL)+":"+IntegerToString(OrderGetInteger(ORDER_MAGIC))+":"+DoubleToString(OrderGetDouble(ORDER_VOLUME_CURRENT),8);}return s;}
void Save(string value){int h=FileOpen("TB_PLANB_G4\\"+InpRunId+"\\RESULT.txt",FILE_WRITE|FILE_TXT|FILE_ANSI|FILE_COMMON);if(h==INVALID_HANDLE){Print("G4D|RESULT_WRITE_ERROR=",GetLastError());return;}FileWriteString(h,value);FileFlush(h);FileClose(h);Print("G4D|",value);}
void OnStart(){if(InpRunId=="")return;long mode=AccountInfoInteger(ACCOUNT_TRADE_MODE);Print("G4D|run=",InpRunId,"|mode=",mode,"|tester=",MQLInfoInteger(MQL_TESTER));if(MQLInfoInteger(MQL_TESTER)||mode!=ACCOUNT_TRADE_MODE_DEMO){Save("BLOCKED_NOT_DEMO");return;}for(int i=0;i<20&&!TerminalInfoInteger(TERMINAL_CONNECTED);i++)Sleep(500);if(!TerminalInfoInteger(TERMINAL_CONNECTED)){Save("BLOCKED_NOT_CONNECTED");return;}string before=Snapshot();long a=ChartOpen("GOLD",PERIOD_M5),b=ChartOpen("GOLD",PERIOD_M5);bool applied=a>0&&b>0&&a!=b;if(applied)applied=ChartApplyTemplate(a,InpTemplateA)&&ChartApplyTemplate(b,InpTemplateB);Sleep(1000);Print("G4D|run=",InpRunId,"|expert_a=",ChartGetString(a,CHART_EXPERT_NAME),"|expert_b=",ChartGetString(b,CHART_EXPERT_NAME),"|error=",GetLastError());ChartSaveTemplate(a,InpRunId+"_observed_A.tpl");string done="";if(applied){for(int i=0;i<40&&!IsStopped();i++){Sleep(1000);int h=FileOpen("TB_PLANB_G4\\"+InpRunId+"\\DONE.txt",FILE_READ|FILE_TXT|FILE_ANSI|FILE_COMMON|FILE_SHARE_READ);if(h!=INVALID_HANDLE){done=FileReadString(h);FileClose(h);break;}}}string expected=InpRunId+"|"+IntegerToString(a)+";"+InpRunId+"|"+IntegerToString(b);string after=Snapshot();bool pass=done==expected&&before==after;Save("run="+InpRunId+"|result="+(pass?"PASS":"FAIL")+"|demo=1|chart_a="+IntegerToString(a)+"|chart_b="+IntegerToString(b)+"|templates="+(applied?"1":"0")+"|exchange="+done+"|before="+before+"|after="+after+"|common="+TerminalInfoString(TERMINAL_COMMONDATA_PATH));if(a>0)ChartClose(a);if(b>0)ChartClose(b);}

